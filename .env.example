SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
ADMIN_KEY=replace-with-random-owner-key
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_PATH=data/state.sqlite3
POLL_INTERVAL_SECONDS=10

# Optional: leave BOTH blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: lyrics need your own Spicy Lyrics application key.
SPICY_LYRICS_SECRET_KEY=
