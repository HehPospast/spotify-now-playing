SPOTIFY_CLIENT_ID=
# Public hosting: https://music.example.com/auth/callback (exact Spotify dashboard match).
# HTTPS is terminated by your reverse proxy; see docs/deployment.md.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
ADMIN_KEY=replace-with-random-owner-key
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_PATH=data/state.sqlite3
POLL_INTERVAL_SECONDS=10

# Optional: leave BOTH blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram message language only: en or ru. Does not affect the widget.
TELEGRAM_LANGUAGE=en

# Optional: lyrics need your own Spicy Lyrics application key.
SPICY_LYRICS_SECRET_KEY=
